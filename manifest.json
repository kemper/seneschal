{
  "manifest_version": 3,
  "name": "Seneschal",
  "version": "0.3.0",
  "description": "A command palette, a configurable floating quick menu, and a hero HP panel for Wardenfall.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Seneschal \u2014 turn the palette and quick menu on or off"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://wardenfall.com/*",
        "https://*.wardenfall.com/*"
      ],
      "js": [
        "src/fuzzy.js",
        "src/catalog.js",
        "src/config.js",
        "src/learned.js",
        "src/scanner.js",
        "src/styles.js",
        "src/dock-styles.js",
        "src/palette.js",
        "src/heroes.js",
        "src/dock.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
